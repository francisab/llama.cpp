+struct test_nemotron_ffn : public test_mul_mat_id {
+    const int route;
+
+    test_nemotron_ffn(ggml_type type, int experts, bool up, int64_t n, int route)
+        : test_mul_mat_id(type, GGML_TYPE_F32, experts, 22, up, up ? 2688 : 1024, n,
+                          up ? 1024 : 2688, 1.0f, 0, true), route(route) {}
+
+    std::string vars() override { return test_mul_mat_id::vars() + ",nem_route=" + std::to_string(route); }
+    std::string op_desc(ggml_tensor *) override { return "NEMOTRON_FFN"; }
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * out = test_mul_mat_id::build_graph(ctx);
+        if (b) {
+            return ggml_sqr(ctx, ggml_relu(ctx, out));
+        }
+        ggml_tensor * weights = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_used, n);
+        ggml_set_name(weights, "expert_weights");
+        return ggml_mul(ctx, out, weights);
+    }
+
+    void set_routes(ggml_context * ctx) {
+        std::default_random_engine rng(1234);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_I32 || ggml_is_view_op(t->op)) {
+                continue;
+            }
+            std::vector<int32_t> data(t->ne[0]);
+            for (int64_t r = 0; r < ggml_nrows(t); ++r) {
+                const int offset = route == 2 && r % 4 == 0 ? (r*31) % n_mats : n_mats - n_used;
+                for (int64_t i = 0; i < t->ne[0]; ++i) {
+                    data[i] = route == 0 ? i % n_mats : (offset + i - int(ids_offset) + n_mats) % n_mats;
+                }
+                if (route == 0) {
+                    std::shuffle(data.begin(), data.begin() + n_mats, rng);
+                }
+                ggml_backend_tensor_set(t, data.data(), r*t->nb[1], data.size()*sizeof(int32_t));
+            }
+        }
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_mul_mat_id::initialize_tensors(ctx);
+        if (ggml_tensor * weights = ggml_get_tensor(ctx, "expert_weights")) {
+            init_tensor_uniform(weights, 0.01f, 1.0f);
+        }
+        set_routes(ctx);
+    }
+
+    void reinit_perf_iter(ggml_context * ctx) override { set_routes(ctx); }
+};
