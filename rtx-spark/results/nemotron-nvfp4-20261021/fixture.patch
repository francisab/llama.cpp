+            tests.emplace_back(new test_nemotron_ffn(GGML_TYPE_NVFP4, experts, true, n, route));
+            tests.emplace_back(new test_nemotron_ffn(GGML_TYPE_NVFP4, experts, false, n, route));
+        }
+    }
+}
