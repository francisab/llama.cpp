+// prefetch the PLE rows of a whole multi-ubatch batch, so later ubatches find their pages in flight
+void llama_qwen4exp_prefetch_ple(const llama_model & model, const int32_t * tokens, size_t n_tokens) {
+    ggml_tensor * ple = model.per_layer_tok_embd;
+    if (!model.can_prefetch.count(ple)) {
+        return;
+    }
+
+    const auto & hparams = model.hparams;
+
+    const int64_t n_gram   = hparams.ple_ngram_size;
+    const int64_t per_gram = hparams.ple_heads_per_ngram;
+    const int64_t eos      = hparams.ple_eos_token_id;
+
+    std::vector<int32_t> idx;
+    idx.reserve(hparams.ple_n_heads * n_tokens);
+    for (int64_t i = n_gram - 1; i < (int64_t) n_tokens; ++i) {
+        uint64_t mixed = (uint64_t) tokens[i] * hparams.ple_layer_multipliers[0];
+        bool cut = false;
+        for (int64_t n = 2; n <= n_gram; ++n) {
+            const int64_t t = tokens[i - (n - 1)];
+            cut = cut || t < 0 || t == eos;
+            mixed ^= (uint64_t) (cut ? eos : t) * hparams.ple_layer_multipliers[n - 1];
+            const int64_t base = (n - 2) * per_gram;
+            for (int64_t g = 0; g < per_gram; ++g) {
+                const int64_t h_i = base + g;
+                idx.push_back((int32_t) (mixed % hparams.ple_head_vocab_sizes[h_i] + hparams.ple_head_offsets[h_i]));
+            }
+        }
+    }
+
+    llama_prefetch_rows(ple, idx.data(), idx.size());
+}
