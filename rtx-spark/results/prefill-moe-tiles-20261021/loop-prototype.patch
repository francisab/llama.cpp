 #include "mmid.cuh"

 #include <cstdint>
+
+template <ggml_type type, bool fallback>
+__launch_bounds__(ggml_cuda_mmq_get_nthreads(type, 16, fallback, GGML_PREC_Q8), ggml_cuda_mmq_get_occupancy(type, 16, fallback, GGML_PREC_Q8))
+static __global__ void mul_mat_q_moe_loop(const mmq_args args) {
+    constexpr int J = 16;
+    constexpr int I = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nthreads = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8);
+    const int it = blockIdx.x;
+    const int zt = blockIdx.z;
+    const int col_low = args.expert_bounds[zt];
+    const int col_diff = args.expert_bounds[zt + 1] - col_low;
+    const int offset_x = zt*args.stride_channel_x + it*I*args.stride_row_x;
+    extern __shared__ int ids_dst_shared[];
+
+    for (int jt = blockIdx.y; jt*J < col_diff; jt += gridDim.y) {
+        __syncthreads();
+        for (int j = threadIdx.y*warp_size + threadIdx.x; j < J; j += nthreads) {
+            ids_dst_shared[j] = args.ids_dst[col_low + jt*J + j];
+        }
+        __syncthreads();
+        const int offset_y = (col_low + jt*J)*(sizeof(block_q8_1_mmq)/sizeof(int));
+        mul_mat_q_process_tile<type, J, fallback, false, GGML_PREC_Q8>
+            (args.x, offset_x, args.y + offset_y, ids_dst_shared, args.dst + it*I, nullptr, nullptr,
+             args.stride_row_x, args.ncols_y, args.nrows_dst,
+             args.nrows_x - it*I - 1, col_diff - jt*J - 1, 0, args.ncols_x/ggml_cuda_type_traits<type>::qk);
+    }
+}
+
+template <ggml_type type, bool fallback>
+static void launch_mul_mat_q_moe_loop(const mmq_args & args, const int cc, cudaStream_t stream) {
+    const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, 16, fallback, cc, GGML_PREC_Q8);
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const int nbytes_shared = mmq_get_nbytes_shared(config, cc);
+    CUDA_SET_SHARED_MEMORY_LIMIT((mul_mat_q_moe_loop<type, fallback>), nbytes_shared);
+    const dim3 block_dims(warp_size, config.nthreads/warp_size, 1);
+    const dim3 block_nums((args.nrows_x + config.I - 1)/config.I, 4, args.nchannels_y);
+    mul_mat_q_moe_loop<type, fallback><<<block_nums, block_dims, nbytes_shared, stream>>>(args);
+    CUDA_CHECK(cudaGetLastError());
+}

