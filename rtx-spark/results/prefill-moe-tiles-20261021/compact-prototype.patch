+static __global__ void mmq_moe_make_jobs(const int32_t * bounds, const int n_experts,
+        int2 * small_jobs, int2 * large_jobs, int * counts) {
+    if (threadIdx.x == 0) {
+        counts[0] = counts[1] = 0;
+    }
+    __syncthreads();
+    for (int expert = threadIdx.x; expert < n_experts; expert += blockDim.x) {
+        const int cols = bounds[expert + 1] - bounds[expert];
+        if (cols == 0) {
+            continue;
+        }
+        const bool large = cols > 32;
+        const int J = large ? 128 : 16;
+        const int ntiles = (cols + J - 1)/J;
+        const int first = atomicAdd(counts + int(large), ntiles);
+        int2 * jobs = large ? large_jobs : small_jobs;
+        for (int tile = 0; tile < ntiles; ++tile) {
+            jobs[first + tile] = make_int2(expert, tile);
+        }
+    }
+}
+
+template <ggml_type type, int J, bool fallback>
+__launch_bounds__(ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8), ggml_cuda_mmq_get_occupancy(type, J, fallback, GGML_PREC_Q8))
+static __global__ void mmq_moe_jobs(
+        const char * __restrict__ x, const int * __restrict__ y, const int32_t * __restrict__ ids,
+        const int32_t * __restrict__ bounds, float * __restrict__ dst,
+        const int2 * __restrict__ jobs, const int * __restrict__ count, const uint3 capacity,
+        const int nrows_x, const int stride_row_x, const int stride_channel_x,
+        const int ncols_y, const int stride_col_dst, const int blocks_per_row) {
+    constexpr int I = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nthreads = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8);
+    const uint2 tile = fast_div_modulo(blockIdx.x, capacity);
+    if (tile.y >= *count) {
+        return;
+    }
+    const int it = tile.x;
+    const int2 job = jobs[tile.y];
+    const int col_low = bounds[job.x];
+    const int col_diff = bounds[job.x + 1] - col_low;
+    extern __shared__ int ids_shared[];
+    for (int j = threadIdx.y*warp_size + threadIdx.x; j < J; j += nthreads) {
+        ids_shared[j] = ids[col_low + job.y*J + j];
+    }
+    __syncthreads();
+    const int offset_x = job.x*stride_channel_x + it*I*stride_row_x;
+    const int offset_y = (col_low + job.y*J)*(sizeof(block_q8_1_mmq)/sizeof(int));
+    mul_mat_q_process_tile<type, J, fallback, false, GGML_PREC_Q8>
+        (x, offset_x, y + offset_y, ids_shared, dst + it*I, nullptr, nullptr,
+         stride_row_x, ncols_y, stride_col_dst, nrows_x - it*I - 1, col_diff - job.y*J - 1, 0, blocks_per_row);
+}
+
+template <ggml_type type, int J, bool fallback>
+static void launch_mmq_moe_jobs(const mmq_args & args, const int2 * jobs, const int * count,
+        const int capacity, const int cc, cudaStream_t stream) {
+    const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc, GGML_PREC_Q8);
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const int nbytes_shared = mmq_get_nbytes_shared(config, cc);
+    CUDA_SET_SHARED_MEMORY_LIMIT((mmq_moe_jobs<type, J, fallback>), nbytes_shared);
+    const dim3 block_dims(warp_size, config.nthreads/warp_size, 1);
+    const int nty = (args.nrows_x + config.I - 1)/config.I;
+    mmq_moe_jobs<type, J, fallback><<<nty*capacity, block_dims, nbytes_shared, stream>>>
+        (args.x, args.y, args.ids_dst, args.expert_bounds, args.dst, jobs, count, init_fastdiv_values(capacity),
+         args.nrows_x, args.stride_row_x, args.stride_channel_x, args.ncols_y, args.nrows_dst,
+         args.ncols_x/ggml_cuda_type_traits<type>::qk);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <ggml_type type, bool fallback>
+static void launch_mmq_moe_compact(ggml_backend_cuda_context & ctx, const mmq_args & args,
+        const int cc, cudaStream_t stream) {
+    const int small_capacity = std::min(args.ncols_dst, (args.ncols_dst + 15)/16 + args.nchannels_y - 1);
+    const int large_experts = std::min(args.nchannels_y, args.ncols_dst/33);
+    const int large_capacity = (args.ncols_dst + 127)/128 + large_experts;
+    ggml_cuda_pool_alloc<int2> jobs(ctx.pool(), small_capacity + large_capacity);
+    ggml_cuda_pool_alloc<int> counts(ctx.pool(), 2);
+    mmq_moe_make_jobs<<<1, 256, 0, stream>>>(args.expert_bounds, args.nchannels_y,
+        jobs.get(), jobs.get() + small_capacity, counts.get());
+    CUDA_CHECK(cudaGetLastError());
+    launch_mmq_moe_jobs<type, 16, fallback>(args, jobs.get(), counts.get(), small_capacity, cc, stream);
+    launch_mmq_moe_jobs<type, 128, fallback>(args, jobs.get() + small_capacity, counts.get() + 1, large_capacity, cc, stream);
+}

